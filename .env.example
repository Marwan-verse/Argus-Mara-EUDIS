# Reference only: the application does NOT automatically load this file.
# Set these through your shell/service. Keep real values out of Git.
# No maintainer infrastructure or credentials are bundled.
ARGUS_LIVE_SERVER=
ARGUS_AIS_AUTOCONNECT=0
ARGUS_SUPABASE_URL=
ARGUS_SUPABASE_PUBLISHABLE_KEY=
ARGUS_SUPABASE_KEY_FILE=
ARGUS_SUPABASE_READ=0
ARGUS_SUPABASE_LINK=0
ARGUS_SATELLITE_AUTOSTART=0
ARGUS_S1_PLAN_NETWORK=0
ARGUS_REAL_ALERTS=0
# Prefer python scripts/configure_satellite.py and configure_gfw.py for OS-keychain storage.
TENSORX_API_KEY=
GFW_API_TOKEN=
# Collector host only; never in frontend code:
AISSTREAM_API_KEY=
# Optional SOC origin; create accounts through your own deployment:
ARGUS_SOC_URL=
