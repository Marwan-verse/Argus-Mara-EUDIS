{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "live/Dockerfile",
    "watchPatterns": ["/argus/live_*.py", "/recorder/recorder.py", "/ui/live/**", "/ui/assets/**", "/live/**", "/railway.json"]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
